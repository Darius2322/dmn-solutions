# Supabase — get these from Supabase Dashboard > Project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The hidden admin route segment. This MUST match the actual folder name
# under app/ (currently app/portal-x7k2/). Rename both together to rotate it.
# Server-side copy (used by middleware.ts and app/robots.ts):
ADMIN_ROUTE_SEGMENT=portal-x7k2
# Public copy (used only by the admin sidebar to build its own links — this
# chunk only loads once someone is already past the middleware auth check,
# so exposing it client-side here doesn't weaken the actual security boundary):
NEXT_PUBLIC_ADMIN_ROUTE_SEGMENT=portal-x7k2

NEXT_PUBLIC_SITE_URL=https://dmn-solution.vercel.app
NEXT_PUBLIC_WHATSAPP=254110554040
