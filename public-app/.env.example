# Supabase — get these from Supabase Dashboard > Project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — used ONLY inside "use server" files (lib/actions/*) to
# insert customer-submitted data (requests, referrals, support, contact).
# Never imported into any client component. Never exposed via NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://dmnsolutions.co.ke
NEXT_PUBLIC_WHATSAPP=254110554040

# Optional: Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional: email alerts for new requests/messages (Resend, resend.com)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
# RESEND_FROM="DMN Solutions <notifications@yourdomain>"   # after verifying your domain in Resend
# NEXT_PUBLIC_ADMIN_URL=https://dmn-solution-admin-app.vercel.app
