# Same Supabase project as the public site — get these from
# Supabase Dashboard > Project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS. Used only inside "use server" files
# (lib/actions/**, lib/auth/**) after getCurrentAdmin() has already verified
# the caller via the RLS-respecting client. Never imported into a client
# component. Set this in Vercel's encrypted env vars, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
